---
const base = import.meta.env.BASE_URL;

/* ===== EDIT YOUR CONTACT LINKS HERE ===== */
const contact = {
    phone: "tel:+910000000000",          // tel:+91XXXXXXXXXX
    mail: "mailto:church@example.com",   // mailto:your@email.com
    instagram: "https://www.instagram.com/",
    facebook: "https://www.facebook.com/",
    youtube: "https://www.youtube.com/",
};
---

<footer class="revelation">
    <div class="covenant">
        <div class="disciple">
            <img
                class="cross-big"
                src={`${base}asset/images/logo/olph_logofinal.png`}
                alt="Our Lady of Perpetual Help Church Logo"
            />
        </div>
        <div class="disciple">
            <h3 data-ta="விரைவு இணைப்புகள்">Quick Links</h3><ul>
                <li><a href={`${base}`} data-ta="முகப்பு">Home</a></li>
                <li><a href={`${base}youth/`} data-ta="இளையோர்">Youth</a></li>
                <li><a href={`${base}contact/`} data-ta="தொடர்புக்கு">Contact</a></li>
            </ul>
        </div>
        <div class="disciple">
            <h3 data-ta="எங்கள் கொள்கை">Our Policy</h3><ul>
                <li>
                    <a href={`${base}privacy-policy/`} data-ta="தனியுரிமைக் கொள்கை"
                        >Privacy Policy</a
                    >
                </li>
                <li>
                    <a href={`${base}disclaimer-policy/`} data-ta="மறுப்புக் கொள்கை"
                        >Disclaimer Policy</a
                    >
                </li>
                <li>
                    <a href={`${base}terms/`} data-ta="விதிமுறைகள் மற்றும் நிபந்தனைகள்"
                        >Terms and Condition</a
                    >
                </li>
                <li>
                    <a href={`${base}legal-policy/`} data-ta="சட்டக் கொள்கை"
                        >Legal Policy</a
                    >
                </li>
            </ul>
        </div>
        <div class="disciple">
            <h3 data-ta="தொடர்பு கொள்ள">Get in Touch</h3><div class="social">
                <a class="social-link" href={contact.phone} aria-label="Phone" title="Phone">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </a>
                <a class="social-link" href={contact.mail} aria-label="Email" title="Email">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
                </a>
                <a class="social-link" href={contact.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/></svg>
                </a>
                <a class="social-link" href={contact.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                </a>
                <a class="social-link" href={contact.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" title="YouTube">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><path d="M9.75 15.02 15.5 11.75 9.75 8.48z"/></svg>
                </a>
            </div>
        </div>
    </div><div
        class="hallelujah"
        data-ta="@ All rights reserved by OLPH Youth"
    >
        @ All rights reserved by OLPH Youth
    </div>
</footer>

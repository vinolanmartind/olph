---
const base = import.meta.env.BASE_URL;
---

<footer class="revelation">
    <div class="covenant">
        <div class="disciple">
            <img
                src={`${base}asset/images/logo_texts.png`}
                alt="Our Lady of Perpetual Help Church Logo"
            />
        </div>
        <div class="disciple">
            <h3 data-ta="விரைவு இணைப்புகள்">Quick Links</h3><ul>
                <li><a href="/" data-ta="முகப்பு">Home</a></li>
                <li><a href="/youth/" data-ta="இளையோர்">Youth</a></li>
                <li><a href="/contact/" data-ta="தொடர்புக்கு">Contact</a></li>
            </ul>
        </div>
        <div class="disciple">
            <h3 data-ta="எங்கள் கொள்கை">Our Policy</h3><ul>
                <li>
                    <a href="/privacy-policy/" data-ta="தனியுரிமைக் கொள்கை"
                        >Privacy Policy</a
                    >
                </li>
                <li>
                    <a href="/disclaimer-policy/" data-ta="மறுப்புக் கொள்கை"
                        >Disclaimer Policy</a
                    >
                </li>
                <li>
                    <a href="/terms/" data-ta="விதிமுறைகள் மற்றும் நிபந்தனைகள்"
                        >Terms and Condition</a
                    >
                </li>
                <li>
                    <a href="/legal-policy/" data-ta="சட்டக் கொள்கை"
                        >Legal Policy</a
                    >
                </li>
            </ul>
        </div>
        <div class="disciple">
            <h3 data-ta="தொடர்பு கொள்ள">Get in Touch</h3><address>
                <span data-ta="189/217, பள்ளி தெரு">189/217, School Street</span
                ><br />
                <span data-ta="பெரியதோப்பு, மணலி">Periyathoppu, Manali</span><br
                />
                <span data-ta="சென்னை – 600 068">Chennai – 600 068</span><br />
                <span data-ta="தொலைபேசி:">Phone:</span>
                <a href="tel:+910000000000">+91 00000 00000</a>
            </address>
        </div>
    </div><div
        class="hallelujah"
        data-ta="© OLPH | அனைத்து உரிமைகளும் இளையோருக்கே"
    >
        © OLPH | All rights reserved by Youth
    </div>
</footer>

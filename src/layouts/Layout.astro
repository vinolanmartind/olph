---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { css, title = "Our Lady of Perpetual Help Church", bodyClass = "" } = Astro.props;
const v = "14";
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const asset = `${base}asset/`;
// true only on the home page (works with the /olph base path)
const trim = (p: string) => p.replace(/\/+$/, "");
const isHome = trim(path) === trim(base) || trim(path) === `${trim(base)}/index.html`;
const bodyClasses = [isHome ? "is-home" : "", bodyClass].filter(Boolean).join(" ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Tamil:wght@600;700&family=Poppins:wght@600;700&display=swap"
    />

    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("theme") || "light";
      } catch (e) {}
    </script>

    <link rel="stylesheet" href={`${asset}css/base.css?v=${v}`} />
    <link rel="stylesheet" href={`${asset}css/header.css?v=${v}`} />
    <link rel="stylesheet" href={`${asset}css/footer.css?v=${v}`} />

    {css && <link rel="stylesheet" href={`${asset}css/${css}.css?v=${v}`} />}
  </head>
  <body class={bodyClasses || undefined}>
    <div
      id="intro-screen"
      class="intro-screen"
      aria-label="Church introduction"
    >
      <video
        id="intro-video"
        class="intro-video"
        autoplay
        muted
        playsinline
        preload="auto"
      >
        <source
          media="(max-width: 767px)"
          src={`${base}asset/videos/mobile_intro.mp4`}
          type="video/mp4"
        />
        <source
          media="(min-width: 768px)"
          src={`${base}asset/videos/pcintro.mp4`}
          type="video/mp4"
        />
      </video>
    </div>

    <Header path={path} />
    <slot />
    <Footer />

    <script is:inline src={`${asset}js/main.js?v=${v}`} defer></script>

    <script is:inline>
      (() => {
        const overlay = document.getElementById("intro-screen");
        const video = document.getElementById("intro-video");
        const introKey = "olph-intro-played";

        if (!overlay || !video) return;

        // Play only once per browser tab session.
        try {
          if (sessionStorage.getItem(introKey) === "yes") {
            overlay.remove();
            return;
          }

          sessionStorage.setItem(introKey, "yes");
        } catch (error) {
          // Continue showing the intro if session storage is unavailable.
        }

        // Hide after five seconds, even if the video is longer.
        window.setTimeout(() => {
          overlay.classList.add("intro-hidden");

          window.setTimeout(() => {
            overlay.remove();
          }, 600);
        }, 5000);

        // Start playback when possible.
        video.play().catch(() => {
          // The timer still hides the intro if playback fails.
        });
      })();
      function switchLanguage(lang) {
       // 1. Update HTML lang attribute so CSS :lang(ta) / [lang="ta"] triggers
      document.documentElement.lang = lang; // 'ta' for Tamil, 'en' for English

      // 2. Your existing data-ta text swapping logic
       document.querySelectorAll('[data-ta]').forEach((el) => {
       if (lang === 'ta') {
        if (!el.dataset.en) el.dataset.en = el.innerHTML; // Save original English
      el.innerHTML = el.dataset.ta;
      } else if (el.dataset.en) {
      el.innerHTML = el.dataset.en;
      }
      });
}
    </script>
  </body>
</html>

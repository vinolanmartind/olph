---
import Layout from '../layouts/Layout.astro';
---
<Layout css="contact">
<main class="gospel">
<div class="shiloh">
<img class="halo" src="/asset/images/logo.png" alt="" onerror="this.style.display='none'">
<h1 class="tidings" data-ta="எங்களைத் தொடர்பு கொள்ளுங்கள்">Contact Us</h1>
</div>
<div class="tabernacle">
<section class="altar">
<h2 data-ta="ஆலய அலுவலகம்">Church Office</h2>
<p><span data-ta="முகவரி:">Address:</span> <span data-ta="189/217, பள்ளி தெரு, பெரியதோப்பு, மணலி, சென்னை – 600 068">189/217, School Street, Periyathoppu, Manali, Chennai – 600 068</span></p>
<p><span data-ta="தொலைபேசி 1:">Phone 1:</span> <a href="tel:+910000000000">+91 00000 00000</a></p>
<p><span data-ta="தொலைபேசி 2:">Phone 2:</span> <a href="tel:+910000000001">+91 00000 00001</a></p>
<p><span data-ta="மின்னஞ்சல்:">Email:</span> <a href="mailto:church@example.com">church@example.com</a></p>
</section>
</div>
<section class="temple">
<h2 data-ta="எங்கள் இடம்">Our Location</h2>
<iframe title="Church location map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=Our+Lady+of+Perpetual+Help+Church,+School+Street,+Periyathoppu,+Manali,+Chennai+600068&amp;output=embed"></iframe>
</section>
</main>
</Layout>
